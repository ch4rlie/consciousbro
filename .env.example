# Resend — required in production for /apply to succeed
RESEND_API_KEY=
APPLY_FROM_EMAIL=

# /meetup scheduler storage — Upstash Redis.
# Auto-injected when you add the Upstash integration from the Vercel Storage tab.
# In local dev, if these are unset the app falls back to a JSON file under .data/.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional secret to enable POST /api/meetup/reset?token=... (wipes all votes).
MEETUP_RESET_TOKEN=
